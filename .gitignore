!data/processed/.gitkeep
*.csv
*.parquet
*.db
*.sqlite
*.sqlite3

# --- Model artifacts ---
*.pkl
*.joblib
*.h5
*.pt
*.onnx
models/artifacts/
mlruns/

# --- Logs ---
*.log
logs/

